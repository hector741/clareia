{
  "name": "clareia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Clareia - organizador de tarefas pessoal, local e em português do Brasil.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
